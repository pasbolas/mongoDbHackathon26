# Atlas connection string (not needed when USE_MOCK=1)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=blast
# set to 1 to use mongomock (in memory, no Atlas)
USE_MOCK=0
# optional, without it the template answer is used
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# optional, without it notify is a preview only
SLACK_WEBHOOK_URL=
